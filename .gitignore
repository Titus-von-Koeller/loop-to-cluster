# This project owns its pixi manifest, so undo the global ignores set in
# ~/dotfiles/home/shell.nix (programs.git.ignores). Those exist to stop pixi files
# leaking into upstream HF repos; here they are the project definition. A repo
# .gitignore outranks core.excludesFile, so these negations win.
!pixi.toml
!pixi.lock

# The solved environment stays ignored — it is large, machine-specific build output.
.pixi/
.direnv/

# Throwaway local Jupyter token — never commit.
.jupyter-token

# Python build artefacts.
__pycache__/
*.egg-info/

# The tokenized corpus is regenerable from the step scripts and too large to version.
.cache/

# `runs/` is deliberately NOT ignored. It is the evidence behind every table in a
# NOTES.md, and a measurement is only regenerable on the same GPU with the same torch
# build — which makes it not regenerable. Committing the prediction and withholding the
# result would leave half of each claim unversioned. A few KB per run.

# Jupyter session state, not content. The notebooks themselves are tracked.
.jupyter/
.jupyter_ystore.db
.ipynb_checkpoints/

# Memory snapshots: large, machine-specific, regenerable with snapshot.py.
bench/snapshots/
