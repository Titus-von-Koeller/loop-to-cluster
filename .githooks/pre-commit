#!/usr/bin/env bash
# Lint gate. Prose rules in CLAUDE.md get broken; this one cannot be.
# Activate with: git config core.hooksPath .githooks
# Bypass a single commit with: git commit --no-verify
set -euo pipefail

# Checks run against the INDEX, not the working tree: a snapshot of exactly what this
# commit will contain is checked out to a temp dir and checked there. Unstaged edits --
# typically in-flight notebook work in an open editor -- can therefore never fail a
# commit they are not part of; before this, they forced --no-verify bypasses and once
# invited an accidental sweep-stage. checkout-index reads staged blobs, so a partially
# staged file is checked as staged, not as it sits on disk.
snapshot=$(mktemp -d)
trap 'rm -rf "$snapshot"' EXIT
git checkout-index --prefix="$snapshot/" -a

# git runs hooks from the repository root, so pixi resolves this project's manifest;
# ruff discovers its config upward from the checked files, finding the snapshot's own
# pyproject.toml.
if ! pixi run ruff check "$snapshot"; then
    echo "pre-commit: ruff check failed on staged content" >&2
    exit 1
fi
if ! pixi run ruff format --check "$snapshot"; then
    echo "pre-commit: ruff format --check failed on staged content (run: pixi run ruff format .)" >&2
    exit 1
fi

# ruff sees valid Python and stops there. It cannot see that two cells define the same
# name, or that a cell no longer parses -- marimo stores such a cell as a call to
# app._unparsable_cell, which is itself valid Python and commits without complaint. Both
# have happened here. --strict because the notebooks are clean of warnings today and the
# cheapest time to keep them that way is now. Takes about a second.
# Underscore-prefixed files beside the notebooks (_viz.py, _palette.py) are plain
# modules, and marimo check rejects any .py it is handed that lacks a marimo.App. A new
# notebook must avoid the underscore prefix to stay under this check.
if ! pixi run marimo check --strict "$snapshot"/notebooks/pytorch-basics/[!_]*.py; then
    echo "pre-commit: marimo check failed on staged content" >&2
    exit 1
fi

# Series invariants, enforced rather than remembered: no dead pytorch.org nav links, and
# exactly one h1 per notebook (the title; sections are h2 and below). Checked only on
# notebooks this commit touches, so a not-yet-polished notebook blocks nobody else.
staged_notebooks=$(git diff --cached --name-only --diff-filter=ACM -- 'notebooks/pytorch-basics/*.py' |
    rg -v '/_' || true)
if [ -n "$staged_notebooks" ]; then
    checks=()
    while IFS= read -r f; do checks+=("$snapshot/$f"); done <<<"$staged_notebooks"
    if ! pixi run python .githooks/check-notebook-invariants.py "${checks[@]}"; then
        echo "pre-commit: notebook series invariants failed on staged content" >&2
        exit 1
    fi
fi

# Datasets land beside the notebooks that download them, and a directory staged whole
# takes them along. 82 MB of FashionMNIST reached origin that way once.
max_kb=1024
large=$(git diff --cached --name-only --diff-filter=A -z |
    while IFS= read -r -d "" f; do
        [ -f "$f" ] || continue
        kb=$(( $(stat -c%s "$f") / 1024 ))
        if [ "$kb" -gt "$max_kb" ]; then printf '%s (%s KB)\n' "$f" "$kb"; fi
    done)
if [ -n "$large" ]; then
    echo "pre-commit: files larger than ${max_kb} KB are being added:" >&2
    echo "$large" >&2
    echo "ignore them, or commit with --no-verify if they belong here" >&2
    exit 1
fi

# Taint gate (dotfiles docs/adr/010): a session that ingested untrusted content may not
# commit reef-shaped files until a sibling session or Titus reviews it. A session with no
# state passes — the gate blocks only explicit taint, never missing information.
colony_py=~/.claude/skills/colony/colony.py
if [ -f "$colony_py" ] && ! pixi run python "$colony_py" gate --staged; then
    echo "pre-commit: the taint gate refused this commit (dotfiles docs/adr/010)" >&2
    exit 1
fi
