#!/usr/bin/env bash
# Pre-push gate: every commit leaving this machine carries a verifiable signature
# (dotfiles docs/adr/009 — signed commits are the system's self-mark). git hands a
# pre-push hook one line per ref on stdin; a zero remote sha means a new branch,
# whose whole local history is checked. Commits older than the founding of signing
# (the commit that added dotfiles' allowed_signers) are exempt.
set -euo pipefail
zero=0000000000000000000000000000000000000000
founding=$(git -C ~/dotfiles log --diff-filter=A --format=%ct -- home/git/allowed_signers 2>/dev/null | tail -1 || true)
[ -n "$founding" ] || exit 0
status=0
while read -r _lref lsha _rref rsha; do
    [ "$lsha" = "$zero" ] && continue  # branch deletion
    if [ "$rsha" = "$zero" ]; then range="$lsha"; else range="$rsha..$lsha"; fi
    while IFS=$'\t' read -r sha sig ts; do
        [ "$ts" -ge "$founding" ] || continue
        if [ "$sig" != "G" ]; then
            echo "pre-push: $sha has signature status '$sig' (need G: valid and in allowed_signers)" >&2
            status=1
        fi
    done < <(git log --format='%h%x09%G?%x09%ct' "$range")
done
[ $status -eq 0 ] || echo "pre-push: refusing to push unsigned commits — see dotfiles docs/adr/009" >&2
exit $status
